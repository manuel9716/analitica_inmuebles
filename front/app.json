{
  "expo": {
    "name": "Fácil Inmuebles",
    "slug": "facil-inmuebles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "facilinmuebles",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.facil.inmuebles",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para búsqueda por voz",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para mostrar propiedades cercanas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "package": "com.facil.inmuebles",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Permitir que Fácil Inmuebles acceda al micrófono."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
